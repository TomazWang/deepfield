{
  "name": "deepfield-doc-site",
  "version": "0.9.0",
  "description": "Docusaurus site builder for Deepfield knowledge base output",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/build.ts src/transform.ts --format esm --dts --clean && npm run copy:template",
    "copy:template": "cp -r template dist/template",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/gray-matter": "^4.0.3",
    "@types/node": "^20.10.6",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
